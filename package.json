{
  "name": "sibos-2025",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently bun:dev:*",
    "dev:client": "bun x --bun vite --mode client",
    "dev:server": "bun x --bun vite ",
    "build": "bun x --bun tsc -b && concurrently bun:build:* -m 1",
    "build:client": "bun x --bun vite build --mode client",
    "build:server": "bun x --bun vite build",
    "lint": "eslint .",
    "start": "bun --port 4123 ./dist/index.js",
    "db:generate-migration": "drizzle-kit generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/pixelify-sans": "^5.2.6",
    "@fontsource-variable/roboto": "^5.2.6",
    "@hono/vite-build": "^1.7.0",
    "@hono/vite-dev-server": "^0.20.1",
    "@hono/zod-validator": "^0.7.2",
    "@reactuses/core": "^6.0.6",
    "@tanstack/react-query": "^5.87.1",
    "drizzle-orm": "^0.44.5",
    "es-toolkit": "^1.39.10",
    "hono": "^4.9.6",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-canvas-confetti": "^2.0.7",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.8.2",
    "react-sounds": "^1.0.25",
    "react-use-websocket": "^4.13.0",
    "use-sound": "^5.0.0",
    "valibot": "^1.1.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.2.22",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "classnames": "^2.5.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "msw": "2.11.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-plugin-svgr": "^4.5.0"
  },
  "prettier": {
    "printWidth": 120
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
